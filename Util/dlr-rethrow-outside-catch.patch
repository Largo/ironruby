 namespace Microsoft.Scripting.Ast {
     public static partial class Utils {
+        /// <summary>
+        /// When set, an exception a frame intercepts only to let it go on - an emulated filter
+        /// that declines it, a fault block, a finally block in an interpreted frame - is rethrown
+        /// once the CLR catch that intercepted it has been left, rather than with a `rethrow'
+        /// inside it (see TryStatementBuilder.ToExpression and Interpreter.Run).
+        ///
+        /// A rethrow inside a catch is a dispatch nested in the one being handled. When every
+        /// frame does it - every IronRuby method frame catches whatever passes through it, for
+        /// its filter - an exception through n frames costs O(n^2) on .NET 8 (minutes for a
+        /// few thousand frames) and, on .NET 9 and later, keeps the exception-dispatch
+        /// machinery of every one of them on the stack, which overflows it - killing the
+        /// process - after a thousand or two.
+        ///
+        /// The price is the exception's CLR stack trace, which restarts at every such frame
+        /// (ExceptionDispatchInfo would keep it, by copying it at every frame, which is
+        /// quadratic again). Interpreted frames are still recorded by the first frame that
+        /// catches the exception. For a language that builds its own backtrace when an exception
+        /// is first caught; set it before any code is compiled.
+        /// </summary>
+        public static bool RethrowOutsideCatch { get; set; }
+
 
