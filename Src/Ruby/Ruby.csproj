<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFrameworks>$(IronRubyTargetFrameworks)</TargetFrameworks>
    <AssemblyName>IronRuby</AssemblyName>
    <RootNamespace>IronRuby</RootNamespace>
  </PropertyGroup>
  <ItemGroup>
    <!-- present in the tree but never compiled by the legacy csproj -->
    <Compile Remove="Runtime\Calls\MemberGroupBuilder.cs" />
    <Compile Remove="Builtins\RubyErrno.cs" />
  </ItemGroup>
  <ItemGroup>
    <!-- Version tracks the target runtime: on net10.0 the 8.0.0 package resolves to an
         assembly older than the one in the shared framework, which NU1605-downgrades. -->
    <PackageReference Include="System.Text.Encoding.CodePages" Version="8.0.0" Condition="'$(TargetFramework)' == 'net8.0'" />
    <PackageReference Include="System.Text.Encoding.CodePages" Version="10.0.0" Condition="'$(TargetFramework)' == 'net10.0'" />
    <ProjectReference Include="$(DlrSourceDir)\Microsoft.Scripting\Microsoft.Scripting.csproj" />
    <ProjectReference Include="$(DlrSourceDir)\Microsoft.Dynamic\Microsoft.Dynamic.csproj" />
  </ItemGroup>
</Project>
