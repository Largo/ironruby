<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net8.0</TargetFramework>
    <AssemblyName>IronRuby.Libraries</AssemblyName>
    <RootNamespace>IronRuby</RootNamespace>
  </PropertyGroup>
  <ItemGroup>
    <!-- present in the tree but never compiled by the legacy csproj -->
    <Compile Remove="Extensions\ScopeOps.cs" />
  </ItemGroup>
  <ItemGroup Condition="'$(BootstrapInitializers)' == 'true'">
    <!-- Bootstrap build for Src/ClassInitGenerator: the generated registrations
         are stale by definition while regenerating them, so leave them out. -->
    <Compile Remove="Initializers.Generated.cs" />
  </ItemGroup>
  <ItemGroup>
    <ProjectReference Include="..\Ruby\Ruby.csproj" />
    <ProjectReference Include="$(DlrSourceDir)\Microsoft.Scripting\Microsoft.Scripting.csproj" />
    <ProjectReference Include="$(DlrSourceDir)\Microsoft.Dynamic\Microsoft.Dynamic.csproj" />
  </ItemGroup>
</Project>
